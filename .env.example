# Deploy method: lambda | worker | actions
# DEPLOY_METHOD=lambda

# GitHub App (required for lambda / worker)
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# For Lambda / Workers: base64-encoded private key (avoids multiline env var issues)
# Generate with: cat private-key.pem | base64
# PRIVATE_KEY_BASE64=

# AI
LLM_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
# App modes: your app slug. Actions mode: github-actions
BOT_NAME=nitpicker-bot

# Limits / behavior
MAX_DIFF_SIZE=50000
REVIEW_ON_OPEN=true

# Lambda deploy (pnpm deploy)
# STACK_NAME=nitpicker
# AWS_REGION=us-east-1

# Cloudflare Workers deploy (pnpm deploy:worker)
# CF_WORKER_NAME=nitpicker
