{
  "name": "pr-reviewer",
  "version": "1.0.0",
  "description": "AI-powered GitHub PR review bot using Vercel AI SDK and Probot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:lambda": "node esbuild.config.mjs",
    "deploy": "pnpm build:lambda && sam deploy",
    "deploy:guided": "pnpm build:lambda && sam deploy --guided",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.45",
    "ai": "^6.0.92",
    "dotenv": "^17.3.1",
    "probot": "^14.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^25.3.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
